# Copy to .env and adjust. Everything is optional.

# Which model connection to use: claude-code (your Claude subscription, via the Claude Code CLI)
# or anthropic (an API key). Defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise claude-code.
# LLM_PROVIDER=claude-code

# --- claude-code ---
# Path to the CLI if it isn't on PATH.
# CLAUDE_BIN=/home/you/.local/bin/claude
# For a headless box: run `claude setup-token` once and paste the token here instead of logging in interactively.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MAX_TOKENS=16000

# Model used when the picker says "Default".
# DEFAULT_MODEL=claude-opus-5-5

# Where conversations and uploaded documents are kept.
# DATA_DIR=./data
# PORT=8787
# Keep 127.0.0.1 and put Tailscale in front (see README). 0.0.0.0 exposes it to your whole network, with no login.
# HOST=127.0.0.1
# MAX_UPLOAD_MB=50
