# Copy to .env and adjust. Everything is optional.

# Which model connection to use: claude-code (your Claude subscription, via the Claude Code CLI)
# or anthropic (an API key). Defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise claude-code.
# ChatGPT models are added on top once you run `npm run chatgpt -- login`; set LLM_PROVIDER=chatgpt to make
# a ChatGPT model the default.
# LLM_PROVIDER=claude-code

# --- claude-code ---
# Path to the CLI if it isn't on PATH.
# CLAUDE_BIN=/home/you/.local/bin/claude
# For a headless box: run `claude setup-token` once and paste the token here instead of logging in interactively.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MAX_TOKENS=16000

# --- chatgpt (your ChatGPT Plus/Pro plan, via Sign in with ChatGPT; no API key) ---
# Where the sign-in is kept (owner-only). Default: ~/.config/digress/chatgpt.json
# CHATGPT_AUTH_FILE=
# Port for the one-time sign-in callback (forward it over SSH when signing in on a remote box).
# CHATGPT_LOGIN_PORT=1457

# Model used when the picker says "Default".
# DEFAULT_MODEL=claude-opus-5-5

# Where conversations and uploaded documents are kept.
# DATA_DIR=./data
# PORT=8787
# Keep 127.0.0.1 and put Tailscale in front (see README). 0.0.0.0 exposes it to your whole network, with no login.
# HOST=127.0.0.1
# The server only answers requests addressed to names it expects, and refuses requests sent from other
# websites (this blocks DNS-rebinding and cross-site tricks). Always allowed: localhost, 127.0.0.1, [::1],
# and the HOST address above if it's a specific one. Add the names you reach it by here, comma separated;
# an entry starting with a dot matches every name under it. Setting this replaces the default (.ts.net, for
# Tailscale Serve); "none" allows only the above.
# ALLOWED_HOSTS=.ts.net,mybox.lan
# MAX_UPLOAD_MB=50

# Web search (the Web button in the app; off until you turn it on). Set WEB_SEARCH=off to remove it.
# WEB_SEARCH=on
# MAX_SEARCHES=5
