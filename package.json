{
  "name": "digress",
  "version": "0.1.0",
  "private": true,
  "description": "A branching chat for learning: highlight any passage and dig into it in a side thread.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "DEV=1 node --watch-path=server server/server.mjs",
    "chatgpt": "node server/chatgpt.mjs",
    "lint": "eslint web/js server demo/build.mjs",
    "test": "python3 tests/run_all.py"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inclusive-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@highlightjs/cdn-assets": "11.9.0",
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.4.17",
    "html-to-image": "1.11.13",
    "marked": "12.0.2",
    "mathjax": "3.2.2",
    "mermaid": "11.17.2",
    "minisearch": "7.1.0",
    "pdfjs-dist": "3.11.174",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "eslint": "^10.15.0"
  }
