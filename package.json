    "test": "python3 tests/run_all.py"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.9.0",
    "dompurify": "3.1.6",
    "marked": "12.0.2",
    "mathjax": "3.2.2",
    "mermaid": "11.4.1",
    "minisearch": "7.1.0",
    "pdfjs-dist": "3.11.174"
  }
}
